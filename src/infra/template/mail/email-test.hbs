<html lang='en'>
   <head>
      <meta charset='UTF-8' />
      <meta name='viewport' content='width=device-width, initial-scale=1.0' />
      <title>Document</title>
   </head>
   <body>
      <div style='font-family: Arial, sans-serif; padding: 24px;'>
         <h2>Teste do Serviço de E-mail 🚀</h2>

         <p>Olá <strong>{{name}}</strong>,</p>

         <p>
            Este é um e-mail enviado para testar o funcionamento completo do sistema de templates,
            variáveis e envio de e-mail.
         </p>

         <hr style='margin: 24px 0;' />

         <h3>🔧 Variáveis de Teste</h3>
         <ul>
            <li><strong>Email:</strong> {{email}}</li>
            <li><strong>Ambiente:</strong> {{environment}}</li>
            <li><strong>Mensagem extra:</strong> {{message}}</li>
         </ul>

         {{#if showButton}}
            <div style='text-align: center; margin: 32px 0;'>
               <a
                  href='{{actionUrl}}'
                  style='
          background-color: #4F46E5;
          color: white;
          padding: 12px 24px;
          text-decoration: none;
          font-weight: bold;
          border-radius: 6px;
        '
               >
                  Botão de Teste
               </a>
            </div>
         {{/if}}

         {{#if items}}
            <h3>📦 Lista de itens enviados</h3>
            <ul>
               {{#each items}}
                  <li>{{this}}</li>
               {{/each}}
            </ul>
         {{/if}}

         <hr style='margin: 24px 0;' />

         <p style='font-size: 12px; color: #888;'>
            ID da operação:
            {{operationId}}
            <br />
            Enviado em:
            {{timestamp}}
         </p>
      </div>

   </body>
</html>
