{
  "name": "api--anual-shop",
  "version": "1.0.0",
  "description": "Webserver that provides resources to the frontend",
  "main": "src/infra/@shared/api/http/express/server.ts",
  "scripts": {
    "tsoa:spec": "tsoa spec",
    "tsoa:routes": "tsoa routes",
    "doc:generate": "npm run tsoa:spec && npm run tsoa:routes",
    "start": "ts-node-dev -r tsconfig-paths/register --transpile-only --ignore-watch node_modules ./src/infra/@shared/api/http/express/server.ts",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:check-types": "clear && npm run tsc -- --noEmit && cross-env NODE_ENV=test jest --runInBand",
    "tsc": "tsc",
    "prisma:generate": "prisma generate --schema=./src/infra/@shared/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./src/infra/@shared/db/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./src/infra/@shared/db/prisma/schema.prisma",
    "cli": "ts-node ./cmd/cli.ts",
    "clean": "rm -rf dist",
    "build": "echo '🔨 Compiling project...' && npm run clean && tsc --project tsconfig.build.json && tsc-alias"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/silverioTenor/api--anual-shop.git"
  },
  "author": "Rodrigo Silvério",
  "license": "ISC",
  "dependencies": {
    "@automapper/classes": "8.8.1",
    "@automapper/core": "8.8.1",
    "@prisma/client": "6.10.1",
    "@scalar/express-api-reference": "^0.8.25",
    "@scalar/openapi-parser": "^0.23.3",
    "bcrypt": "6.0.0",
    "dotenv": "16.5.0",
    "express": "4.21.2",
    "express-async-errors": "3.1.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "8.16.2",
    "reflect-metadata": "0.1.14",
    "tsoa": "^6.6.0",
    "tsyringe": "^4.10.0",
    "yup": "1.6.1"
  },
  "devDependencies": {
    "@swc/cli": "0.7.7",
    "@swc/core": "1.12.1",
    "@swc/jest": "0.2.38",
    "@types/bcrypt": "5.0.2",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "24.0.3",
    "@types/pg": "8.15.4",
    "chalk": "5.4.1",
    "commander": "14.0.0",
    "cross-env": "7.0.3",
    "inquirer": "12.6.3",
    "jest": "30.0.0",
    "prettier": "3.6.1",
    "prisma": "6.10.1",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.8.16",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
